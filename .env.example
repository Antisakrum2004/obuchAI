# Neon PostgreSQL Connection String
# Get from: Neon Console → Dashboard → Connection Details
# Use the "Pooled connection" URL for Vercel
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin credentials (REQUIRED — no hardcoded fallbacks, admin login will be disabled if not set)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-in-production"
# Seed endpoint key (REQUIRED — no hardcoded fallback)
ADMIN_SEED_KEY="change-this-in-production"

# Vercel Blob Storage (auto-set on Vercel, needed for local dev)
# Get from: Vercel Dashboard → Project → Storage → Blob → .env.local tab
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# Storage provider: "vercel-blob" (default) | "s3" (Selectel) | "minio" (future)
STORAGE_PROVIDER="s3"

# S3 / Selectel Object Storage Configuration
# Used when STORAGE_PROVIDER="s3"
S3_ACCESS_KEY_ID="your-access-key-from-selectel"
S3_SECRET_ACCESS_KEY="your-secret-key-from-selectel"
S3_ENDPOINT="https://s3.ru-7.storage.selcloud.ru"
S3_REGION="ru-7"
S3_BUCKET_NAME="ati-lab"

# AI Provider — OpenRouter / OpenAI API key
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxx"

# Z-AI SDK Configuration (required on Vercel — .z-ai-config file is unavailable)
# Get these from your .z-ai-config file or Z-AI dashboard
ZAI_BASE_URL="https://internal-api.z.ai/v1"
ZAI_API_KEY="Z.ai"
ZAI_CHAT_ID="optional-chat-id"
ZAI_USER_ID="optional-user-id"
ZAI_TOKEN="optional-jwt-token"
